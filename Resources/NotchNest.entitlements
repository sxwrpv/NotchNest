<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The hardened runtime blocks these unless granted here. Each still
         needs the user's permission (System Settings → Privacy & Security). -->
    <!-- Now Playing: AppleScript to Music and Spotify -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Dictation: the engine records as NotchNest's child process -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Calendar module (EventKit) -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
